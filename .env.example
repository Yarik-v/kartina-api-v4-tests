# Host from the `host` server variable of spec/openapi.yaml: rustvt.kartina.tv
# (default, staging), iptv.kartina.tv (production) or localhost. V4_API_SCHEME is
# https (default) or http.
V4_API_HOST=rustvt.kartina.tv

# Subscriber credentials for POST /login. Without them every test that needs a
# session skips itself. Never commit real values.
V4_LOGIN=
V4_PASSWORD=

# Optional: the account's protect (parental) code. Only the protect-code and
# hidden-channel tests use it; they skip without it. The suite never changes it.
V4_PROTECT_CODE=

# Optional: a device model the server knows, and the serial of the suite's session.
# V4_DEVICE=androidtv-yb-005
# V4_SERIAL=playwright-v4-main

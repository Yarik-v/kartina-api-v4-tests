{
  "name": "kartina-api-v4-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript tests for the Kartina.TV middleware API v4 (https://pages.kartina.tv/middleware/docs/v4/)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:browser": "V4_BROWSER_ONLY=1 playwright test",
    "report": "node scripts/open-report.mjs",
    "report:bugs": "node scripts/bug-report.mjs",
    "spec:refresh": "node scripts/fetch-openapi.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.2"
  }
}
